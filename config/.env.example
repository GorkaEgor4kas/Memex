# Memex — Environment Variables
# Copy this file to .env and fill in your values

# === Vault Path ===
# Path to your Obsidian vault (overrides pyproject.toml)
# MEMEX_VAULT_PATH=~/Documents/Obsidian

# === Work Mode ===
# auto — use API if internet and key are available, otherwise offline
# online — force API even if offline search would work
# offline — search only, no LLM calls
# MEMEX_MODE=auto

# === LLM Provider ===
# groq or deepseek
MEMEX_PROVIDER=groq

# === LLM API Keys ===
GROQ_API_KEY=gsk_your_key_here
# DEEPSEEK_API_KEY=sk_your_key_here

# === LLM Model ===
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# DeepSeek: deepseek-chat
MEMEX_MODEL=llama-3.3-70b-versatile

# === LLM Parameters ===
# MEMEX_TEMPERATURE=0.2
# MEMEX_MAX_TOKENS=1000

# === Storage Paths ===
# Override default storage locations (optional)
# MEMEX_CHROMA_DB_PATH=~/.memex/chroma_data
# MEMEX_BM25_INDEX_PATH=~/.memex/bm25_index

# === Indexing ===
# MEMEX_CHUNK_SIZE=500
# MEMEX_CHUNK_OVERLAP=50
# MEMEX_USE_PARENTAL=true

# === Retrieval ===
# MEMEX_SEMANTIC_LIMIT=10
# MEMEX_BM25_LIMIT=10
# MEMEX_RRF_K=60
# MEMEX_FINAL_LIMIT=5

# === Thresholds ===
# MEMEX_BM25_MIN_SCORE=1.0
# MEMEX_VECTOR_MIN_SIMILARITY=0.5