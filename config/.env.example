# Obsidian RAG — Environment Variables
# Copy this file to .env and fill in your values

# === Vault Path ===
# Path to your Obsidian vault (overrides pyproject.toml)
# OBSIDIAN_RAG_VAULT_PATH=~/Documents/Obsidian

# === Work Mode ===
# auto — use API if internet and key are available, otherwise offline
# online — force API even if offline search would work
# offline — search only, no LLM calls
# OBSIDIAN_RAG_MODE=auto

# === LLM Provider ===
# groq or deepseek
OBSIDIAN_RAG_PROVIDER=groq

# === LLM API Keys ===
GROQ_API_KEY=gsk_your_key_here
# DEEPSEEK_API_KEY=sk_your_key_here

# === LLM Model ===
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# DeepSeek: deepseek-chat
OBSIDIAN_RAG_MODEL=llama-3.3-70b-versatile

# === LLM Parameters ===
# OBSIDIAN_RAG_TEMPERATURE=0.2
# OBSIDIAN_RAG_MAX_TOKENS=1000

# === Storage Paths ===
# Override default storage locations (optional)
# OBSIDIAN_RAG_CHROMA_DB_PATH=~/.obsidian-rag/chroma_data
# OBSIDIAN_RAG_BM25_INDEX_PATH=~/.obsidian-rag/bm25_index

# === Indexing ===
# OBSIDIAN_RAG_CHUNK_SIZE=500
# OBSIDIAN_RAG_CHUNK_OVERLAP=50
# OBSIDIAN_RAG_USE_PARENTAL=true

# === Retrieval ===
# OBSIDIAN_RAG_SEMANTIC_LIMIT=10
# OBSIDIAN_RAG_BM25_LIMIT=10
# OBSIDIAN_RAG_RRF_K=60
# OBSIDIAN_RAG_FINAL_LIMIT=5

# === Thresholds ===
# OBSIDIAN_RAG_BM25_MIN_SCORE=1.0
# OBSIDIAN_RAG_VECTOR_MIN_SIMILARITY=0.5